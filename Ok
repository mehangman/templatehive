#include <stdio.h>
#include <conio.h>

struct Student
{
    int roll;
    char name[30];
    float marks;
};

void display(struct Student s)
{
    printf("\nStudent Details");
    printf("\nRoll Number: %d", s.roll);
    printf("\nName: %s", s.name);
    printf("\nMarks: %.2f", s.marks);
}

void main()
{
    struct Student s;

    clrscr();

    printf("Enter Roll Number: ");
    scanf("%d", &s.roll);

    printf("Enter Name: ");
    scanf("%s", s.name);

    printf("Enter Marks: ");
    scanf("%f", &s.marks);

    display(s);

    getch();
}
