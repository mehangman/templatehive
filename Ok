#include <stdio.h>
#include <conio.h>

struct Student
{
    int roll;
    char name[30];
    float marks;
};

void main()
{
    struct Student s[3];
    int i;

    clrscr();

    for(i = 0; i < 3; i++)
    {
        printf("\nEnter details of Student %d", i+1);

        printf("\nEnter Roll Number: ");
        scanf("%d", &s[i].roll);

        printf("Enter Name: ");
        scanf("%s", s[i].name);

        printf("Enter Marks: ");
        scanf("%f", &s[i].marks);
    }

    printf("\n\nStudent Details");

    for(i = 0; i < 3; i++)
    {
        printf("\n\nRoll Number: %d", s[i].roll);
        printf("\nName: %s", s[i].name);
        printf("\nMarks: %.2f", s[i].marks);
    }

    getch();
}
