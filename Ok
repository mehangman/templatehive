#include <stdio.h>
#include <conio.h>

struct Student
{
    int roll;
    char name[30];
    float marks;
};

void main()
{
    struct Student s1, s2;

    clrscr();

    printf("Enter Roll Number: ");
    scanf("%d", &s1.roll);

    printf("Enter Name: ");
    scanf("%s", s1.name);

    printf("Enter Marks: ");
    scanf("%f", &s1.marks);

    s2 = s1;

    printf("\nOriginal Structure");

    printf("\nRoll Number: %d", s1.roll);
    printf("\nName: %s", s1.name);
    printf("\nMarks: %.2f", s1.marks);

    printf("\n\nCopied Structure");

    printf("\nRoll Number: %d", s2.roll);
    printf("\nName: %s", s2.name);
    printf("\nMarks: %.2f", s2.marks);

    getch();
}
