#include <stdio.h>

// Inner structure
struct Date
{
    int day;
    int month;
    int year;
};

// Outer structure
struct Student
{
    int roll;
    char name[30];
    struct Date dob;  // Nested structure member
};

int main()
{
    struct Student s;

    printf("Enter Roll Number: ");
    scanf("%d", &s.roll);

    printf("Enter Student Name: ");
    scanf("%29s", s.name);

    printf("Enter Date of Birth (DD MM YYYY): ");
    scanf("%d %d %d", &s.dob.day,
          &s.dob.month, &s.dob.year);

    printf("\n----- Student Details -----");
    printf("\nRoll Number: %d", s.roll);
    printf("\nName: %s", s.name);
    printf("\nDate of Birth: %02d/%02d/%04d",
           s.dob.day, s.dob.month, s.dob.year);

    return 0;
}
